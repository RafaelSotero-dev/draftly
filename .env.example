# Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================

# Application environment mode
# - development: Allows HTTP, enables debug features
# - production: Requires HTTPS, optimized builds
# Requirements: NFR-Segurança 5, 6
NODE_ENV=development

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL via Supabase)
# =============================================================================

# PostgreSQL connection URL for Prisma (Session Pool - port 6543)
# Used for: Application database operations
# Format: postgresql://[user]:[password]@[host]:6543/[database]?pgbouncer=true
# Get from: Supabase Dashboard > Project Settings > Database > Connection string > Session pooler
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL for migrations (port 5432)
# Used for: Prisma migrations (bypasses connection pooler)
# Format: postgresql://[user]:[password]@[host]:5432/[database]
# Get from: Supabase Dashboard > Project Settings > Database > Connection string > Direct connection
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-1-us-east-2.pooler.supabase.com:5432/postgres"

# =============================================================================
# SUPABASE AUTH CONFIGURATION
# =============================================================================

# Supabase project URL
# Used for: Supabase Auth client initialization
# Format: https://[project-ref].supabase.co
# Get from: Supabase Dashboard > Project Settings > API > Project URL
# VITE_ prefix exposes this variable to the Vite client bundle
VITE_SUPABASE_URL="https://[project-ref].supabase.co"

# Supabase anonymous key (public, safe to expose)
# Used for: Client-side authentication with Supabase Auth
# Get from: Supabase Dashboard > Project Settings > API > Project API keys > anon public
# VITE_ prefix exposes this variable to the Vite client bundle
# This key is safe to expose in client-side code - it has limited permissions via RLS
VITE_SUPABASE_ANON_KEY=""

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Port the Fastify server listens on
# Default: 3001
PORT=3001

# Host the Fastify server binds to
# Use 0.0.0.0 to accept connections from any interface (required in containers/cloud)
# Default: 0.0.0.0
HOST=0.0.0.0
# =============================================================================
#
# 1. DATABASE_URL contains sensitive credentials - NEVER expose in client code
# 2. VITE_ prefixed variables are bundled into client-side code - only use for safe values
# 3. SUPABASE_ANON_KEY is safe to expose - it's designed for client-side use with RLS protection
# 4. In production, ensure NODE_ENV=production for HTTPS enforcement
#
# For more information, see:
# - https://supabase.com/docs/guides/database/connecting-to-postgres
# - https://supabase.com/docs/guides/local-development
